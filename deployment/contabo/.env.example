# Copy to deployment/contabo/.env (mode 600) and fill every blank value.
# Generate independent random values locally; never commit or paste the result into chat.
INFLUX_ADMIN_USER=projectd-admin
INFLUX_ADMIN_PASSWORD=
INFLUX_ORG=coil
INFLUX_TOKEN=
# Least-privilege tokens, written by deployment/contabo/scoped_tokens.py after the first start.
# Empty = Telegraf and Grafana fall back to INFLUX_TOKEN (the operator token).
INFLUX_TELEGRAF_TOKEN=
INFLUX_GRAFANA_TOKEN=

# Must match the telegraf account generated by docker/mosquitto/scripts/gen-passwd.sh.
MQTT_TELEGRAF_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ALERT_EMAIL=alerts@example.org

# Email delivery remains disabled until valid SMTP settings are supplied and tested.
GF_SMTP_ENABLED=false
GF_SMTP_HOST=
GF_SMTP_FROM_ADDRESS=
GF_SMTP_USER=
GF_SMTP_PASSWORD=
