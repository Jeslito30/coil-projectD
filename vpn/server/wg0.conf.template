# Project D — WireGuard server template
# Copy to /etc/wireguard/wg0.conf on the server, replace placeholders locally,
# then set permissions: chmod 600 /etc/wireguard/wg0.conf
# Never commit the rendered file or any private key.

[Interface]
Address    = 10.66.0.1/24
ListenPort = 51820
PrivateKey = <SERVER_PRIVATE_KEY>
MTU        = 1420

# Prevent the hub from routing traffic between VPN peers.
# add-peer.sh uses `wg syncconf` so adding a peer does not restart the tunnel.
PostUp   = iptables -A FORWARD -i wg0 -o wg0 -j DROP
PostDown = iptables -D FORWARD -i wg0 -o wg0 -j DROP

# Enrol peers with vpn/add-peer.sh. One block and one /32 per device.
# Example only — replace both values and remove the leading comment markers.
# [Peer]
# # pl-member-1
# PublicKey  = <PEER_PUBLIC_KEY>
# AllowedIPs = 10.66.0.21/32
