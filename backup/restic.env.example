# Copy outside Git to /etc/projectd/restic.env (mode 600, owned by root).
# Generate a unique repository password locally; never commit real values.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=

# Uncomment only the credentials required by the chosen Restic backend.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# B2_ACCOUNT_ID=
# B2_ACCOUNT_KEY=
# AZURE_ACCOUNT_NAME=
# AZURE_ACCOUNT_KEY=
# GOOGLE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=

# Optional: override the default /var/tmp staging parent if space is limited.
# BACKUP_STAGING=/var/tmp

# 1 = the repository is append-only for this server (recommended while the host also runs other
# internet-facing services). backup.sh then skips forget/prune; run retention from a trusted machine:
#   restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 3 --prune
RESTIC_APPEND_ONLY=0
