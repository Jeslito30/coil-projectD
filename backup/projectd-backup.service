[Unit]
Description=Encrypted Project D backup
Documentation=https://github.com/Jeslito30/coil-projectD
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PROJECT_ROOT=/opt/coil-projectD
Environment=BACKUP_ENV=/etc/projectd/restic.env
ExecStart=/opt/coil-projectD/backup/backup.sh
WorkingDirectory=/opt/coil-projectD
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
