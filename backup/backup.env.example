# /etc/projectd/backup.env (root, mode 600): read by projectd-backup.service, overrides its defaults.
# Example for the hand-built coil-checkin2 stack. Adjust the paths to the server, then:
#   sudo systemctl daemon-reload && sudo systemctl start projectd-backup.service && journalctl -u projectd-backup -n 50

# Reviewed checkout of this repository (provides backup.sh).
PROJECT_ROOT=/opt/coil-projectD
# Restic repository settings (backup/restic.env.example).
BACKUP_ENV=/etc/projectd/restic.env

# Back up the RUNNING stack through its own compose and .env files (service names influxdb/grafana/mosquitto).
PROJECTD_COMPOSE_FILE=/opt/COIL_Checkin2_Contabo_Starter/docker-compose.yml
PROJECTD_ENV_FILE=/opt/COIL_Checkin2_Contabo_Starter/.env
# Name of the variable in that .env that holds the InfluxDB operator token (if it is not INFLUX_TOKEN).
BACKUP_INFLUX_TOKEN_VAR=INFLUX_TOKEN
# Also store the whole live deployment directory (compose, .env, Telegraf, Mosquitto config/certs, Grafana provisioning).
BACKUP_EXTRA_PATHS=/opt/COIL_Checkin2_Contabo_Starter
# 1 = stop Grafana and Mosquitto for a few seconds for consistent copies (default); 0 = no interruption.
BACKUP_STOP_SERVICES=1
